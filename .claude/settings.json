{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@synced": false,
    "spec-driven-dev@synced": false,
    "engineering@synced": false,
    "agent-architecture-designer@synced": false,
    "supabase@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    }
  },
  "skillOverrides": {
    "to-spec": "off"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh run view *)",
      "Bash(git pull --ff-only*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(git merge *)",
      "Bash(git fetch*)",
      "Bash(git rev-parse *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge *)",
      "Agent(fork)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guardrails.mjs"] }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.mjs"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-gate.mjs"],
            "timeout": 600,
            "statusMessage": "verify-gate: format + typecheck + related tests"
          }
        ]
      }
    ]
  }
}
